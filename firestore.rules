// Regras de segurança do Firestore (fonte da verdade versionada).
// Publicar colando no console do Firebase (Firestore → Regras).
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin = conta logada que tem documento em /admins/{uid}.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Master: admin com role "master" (definido direto no banco). Só um master
    // remove, exclui ou muda o papel de outro master.
    function isMaster() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.get('role', 'admin') == 'master';
    }

    function isSelf(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /reserves/{docId} {
      allow create: if true;
      allow read: if true;
      // O cliente (sem login) só pode cancelar a reserva em /cancelreserve:
      // muda apenas status/canceledAt/canceledBy/canceledReason, para "canceled".
      allow update: if isAdmin()
        || (resource.data.status != 'canceled'
            && request.resource.data.status == 'canceled'
            && request.resource.data.canceledBy == 'user'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'canceledAt', 'canceledBy', 'canceledReason']));
      allow delete: if isAdmin();
    }

    match /musicRecommendations/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /quiz-participants/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /bolao-participants/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /voting-votes/{docId} {
      allow create: if true;
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    match /voting-entries/{docId} {
      allow create: if true;
      allow read: if true;
      // Cliente só pode editar nome/fotos de fantasias enviadas por cliente
      allow update: if isAdmin()
        || (resource.data.submittedByClient == true
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'images']));
      allow delete: if isAdmin();
    }

    // Cada um lê o próprio documento; só admin lista e altera. Master é protegido:
    // admin normal não remove, não altera e não cria master, nem muda o papel de ninguém.
    match /admins/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isAdmin()
        && (request.resource.data.get('role', 'admin') != 'master' || isMaster());
      allow update: if isAdmin()
        && (resource.data.get('role', 'admin') != 'master' || isMaster())
        && (request.resource.data.get('role', 'admin') == resource.data.get('role', 'admin') || isMaster());
      allow delete: if isAdmin()
        && (resource.data.get('role', 'admin') != 'master' || isMaster());
    }

    // Pedido criado no /signup pela própria conta, com o e-mail dela.
    match /adminRequests/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid)
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.createdAt == request.time;
      allow update, delete: if isAdmin();
    }

    // Aluguel de jogos: catálogo público; "bookings" só o servidor altera.
    match /rentalGames/{gameId} {
      allow read: if true;
      allow create: if isAdmin() && request.resource.data.bookings == [];
      allow update: if isAdmin()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['bookings']);
      allow delete: if isAdmin() && resource.data.bookings.size() == 0;
    }

    match /rental-config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Pedidos: o dono (ou admin) lê; escrita só pelo servidor.
    match /rentals/{rentalId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    // Pagamento online: o dono (ou admin) lê; escrita só pelo servidor.
    match /rentalOrders/{orderId} {
      allow read: if isAdmin() || (request.auth != null && resource.data.customerUid == request.auth.uid);
      allow write: if false;
    }

    match /rentalCustomers/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /rentalCpfIndex/{cpf} { allow read, write: if false; }
    match /authEmailThrottle/{id} { allow read, write: if false; }

    // Leitura pública em tudo, menos nas coleções com dados pessoais.
    // Escrita de admin vale em tudo, exceto nas coleções protegidas/só-servidor.
    match /{collection}/{document=**} {
      allow read: if !(collection in ['admins', 'adminRequests', 'rentals', 'rentalOrders', 'rentalCustomers', 'rentalCpfIndex', 'authEmailThrottle']);
      allow write: if isAdmin() && !(collection in ['rentalGames', 'rentals', 'rentalOrders', 'rentalCustomers', 'rentalCpfIndex', 'authEmailThrottle']);
    }

  }
}
