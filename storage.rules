// Regras de segurança do Storage (fonte da verdade versionada).
// Publicar colando no console do Firebase (Storage → Regras).
rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid));
    }

    match /voting-entries/{fileName} {
      allow read: if true;
      allow create: if request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if true; // a edição da fantasia apaga as fotos removidas
      allow update: if isAdmin();
    }

    match /rental-games/{fileName} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

  }
}
